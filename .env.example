# Copy this file to ".env" on the server and fill in real values.
# .env is gitignored and never leaves the server.

# Secret that unlocks /admin. Make it long and random.
ADMIN_KEY=change-me-to-something-random

# Optional overrides (defaults are fine):
# PORT=3000
# HOST=127.0.0.1
# CATCH_RADIUS_M=30
